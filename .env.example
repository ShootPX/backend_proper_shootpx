# Every variable below is REQUIRED. The app will not start if any is missing.
# Local dev: copy this file to .env
# Cloud: set these as environment variables in your host's dashboard.

APP_NAME=shootpx-backend

# development | production
ENV=development

# Local dev: 127.0.0.1
# Cloud/server: 0.0.0.0  (listen on all interfaces so traffic can reach it)
HOST=127.0.0.1

# Port the app listens on. Many cloud hosts provide this as $PORT.
PORT=8000

# Comma-separated list of allowed frontend origins (no spaces needed).
# Dev example:  http://localhost:3000,http://localhost:5500  (5500 = test-console)
# Prod example: https://app.shootpx.com,https://shootpx.com
CORS_ORIGINS=http://localhost:3000,http://localhost:5500,http://127.0.0.1:5500

# Base URL where the test console / frontend is served (no trailing slash).
# Used to build links in emails (team invites, etc).
# Dev: http://localhost:3000   Prod: https://app.shootpx.com
FRONTEND_URL=http://localhost:3000

DATABASE_URL=postgresql://user:password@host:5432/dbname

# Redis / Upstash — used for caching and rate-limit counters
REDIS_URL=rediss://default:password@host:6379

# Secret required by POST /admin/cache/clear (any long random string)
CACHE_CLEAR_SECRET=your-random-secret-here

# Path to the Firebase service account JSON (used to verify ID tokens).
# Download from Firebase console > Project settings > Service accounts.
# Keep this file out of git (already in .gitignore).
FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json

# --- Resend SMTP (sends the email sign-in link and team-invite emails) ---
# REQUIRED for magic-link login and team invites to actually deliver mail.
# SMTP_PASSWORD is the re_... API key from Resend -> API Keys -> Create API Key.
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=
EMAIL_FROM_NAME=ShootPX
EMAIL_FROM_ADDRESS=noreply@yourdomain.com

# Set true ONLY when deployed behind a reverse proxy / load balancer (Render,
# nginx, Cloudflare…). Makes rate limiting read the real client IP from
# X-Forwarded-For. Leave false locally — the header is spoofable without a proxy.
TRUST_PROXY=false

# razorpay keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

FAL_KEY=
PUBLIC_BACKEND_URL=

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Max fal.ai jobs in flight per team at once
FAL_PER_TEAM_CONCURRENCY_LIMIT=5

# --- OPTIONAL (safe defaults; app boots without them) ---
# Seconds the arq worker loop may be silent before the watchdog alerts + exits. 0 disables.
# WORKER_WATCHDOG_SECONDS=180
# Slack/Discord-style incoming webhook that receives the WORKER_FROZEN alert.
# ALERT_WEBHOOK_URL=
# Hours an unpaid plan-switch checkout stays pending before it is cancelled (default 24)
# PENDING_SWITCH_TTL_HOURS=24

# --- Dev tooling only (used by _bench.py, not by the app) ---
# Firebase console > Project settings > Web API Key
# FIREBASE_WEB_API_KEY=

# --- Real-database tests (tests marked real_db) ---
# The suite never reads DATABASE_URL. Point this at a DEDICATED local database whose name
# contains "test" (e.g. createdb shootpx_test); real_db tests are skipped when it is unset.
# A remote host must also be listed in TEST_DATABASE_ALLOWED_HOSTS. Anything that looks like
# production makes pytest refuse to run at all (see tests/db_guard.py).
# TEST_DATABASE_URL=postgresql://postgres:<password>@localhost:5432/shootpx_test
# TEST_DATABASE_ALLOWED_HOSTS=
# Hosted dev/test project (shared host, database named "postgres"): opt in explicitly. This relaxes
# ONLY the local-host and "test"-in-name rules; a production-looking name or a
# TEST_DATABASE_DENY_SUBSTRINGS match is still refused. Tests then never create/alter its schema.
# TEST_DATABASE_ALLOW_DEV=1
# TEST_DATABASE_DENY_SUBSTRINGS=<your production project ref or host>
