# Copy to /opt/shootpx/backend/.env on the VPS and fill in real values.
# Then: chmod 600 .env yeh just some thing bro
APP_NAME=shootpx-backend
ENV=production
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=https://app.shootpx.com,https://shootpx.com
FRONTEND_URL=https://app.shootpx.com
DATABASE_URL=
REDIS_URL=
CACHE_CLEAR_SECRET=
FIREBASE_CREDENTIALS_PATH=/opt/shootpx/backend/firebase-service-account.json
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=
EMAIL_FROM_NAME=ShootPX
EMAIL_FROM_ADDRESS=noreply@yourdomain.com
TRUST_PROXY=true
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
FAL_KEY=
# MUST be the public HTTPS URL: fal.ai and Razorpay call back to it
PUBLIC_BACKEND_URL=https://api.example.com
# --- File storage for NEW uploads (database stays Supabase Postgres via DATABASE_URL) ---
# "r2" (default) = Cloudflare R2, "supabase" = Supabase Storage. Selected ONLY by this
# variable. Existing rows keep their full Supabase URLs, so the Supabase project and
# its public bucket must stay available for old images to load.
STORAGE_BACKEND=r2
# Required when STORAGE_BACKEND=r2:
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public base URL of the bucket (custom domain or r2.dev), e.g. https://cdn.example.com
R2_PUBLIC_BASE_URL=
# Optional key prefix, e.g. "dev/" (leave empty for none)
R2_KEY_PREFIX=
# Required when STORAGE_BACKEND=supabase (optional otherwise):
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
FAL_PER_TEAM_CONCURRENCY_LIMIT=5
