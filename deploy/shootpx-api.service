[Unit]
Description=ShootPX API (FastAPI / uvicorn)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=shootpx
Group=shootpx
WorkingDirectory=/opt/shootpx/backend
# Settings are read from .env in WorkingDirectory (see .env.production.example)
ExecStart=/opt/shootpx/backend/venv/bin/uvicorn app.main:app \
    --host 127.0.0.1 --port 8000 --workers 2 \
    --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=always
RestartSec=3
# Hardening
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
